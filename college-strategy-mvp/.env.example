# ========== 双节点路由 ==========
# auto = 优先 US 侧（OpenAI / Ollama 等），否则中国方舟
# us   = 仅 US 侧   |  cn = 仅方舟
LLM_REGION=auto

# ========== OpenAI 官方（sk-）或 Ollama（OpenAI 兼容）==========
# 方式 A：显式写 US_*（推荐）
US_OPENAI_API_KEY=
US_OPENAI_MODEL=gpt-4o-mini
# Ollama 云（key 在 https://ollama.com/settings/keys ）示例：
# US_OPENAI_MODEL=gpt-oss:120b
# US_OPENAI_BASE_URL=https://ollama.com/v1
# 本地 Ollama：US_OPENAI_API_KEY=ollama  US_OPENAI_BASE_URL=http://127.0.0.1:11434/v1  US_OPENAI_MODEL=llama3.2

# 方式 B：官方变量名（与 US_OPENAI_API_KEY 二选一即可）
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=https://ollama.com/v1

# ========== 中国火山方舟（ark- + ep- 接入点）==========
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=
OPENAI_MODEL=
# ARK_API_KEY=
# ARK_ENDPOINT_ID=ep-xxxx

# ========== 本地 API 端口 ==========
PORT=8788

# ========== 专家咨询留资（默认 data/expert-consult-leads.jsonl + data/expert-consult-leads.csv，见 data/expert-consult-leads-README.txt）==========
# CONSULT_LEADS_FILE=my-leads.jsonl

# ========== 可选：生成报告调优 ==========
# LLM_MAX_RETRIES=0
# LLM_TIMEOUT_MS=120000
# COMPLETION_MAX_TOKENS=6000
