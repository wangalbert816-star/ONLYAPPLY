# ========== 双节点路由 ==========
# auto = 优先 US 侧（OpenAI / Ollama 等），否则中国方舟
# us   = 仅 US 侧   |  cn = 仅方舟
LLM_REGION=auto

# ========== OpenAI 官方（sk-）或 Ollama（OpenAI 兼容）==========
# 方式 A：显式写 US_*（推荐）
US_OPENAI_API_KEY=
US_OPENAI_MODEL=gpt-4o-mini
# Ollama 云（key 在 https://ollama.com/settings/keys ）示例：
# US_OPENAI_MODEL=gpt-oss:120b
# US_OPENAI_BASE_URL=https://ollama.com/v1
# 本地 Ollama：US_OPENAI_API_KEY=ollama  US_OPENAI_BASE_URL=http://127.0.0.1:11434/v1  US_OPENAI_MODEL=llama3.2

# 方式 B：官方变量名（与 US_OPENAI_API_KEY 二选一即可）
# OLLAMA_API_KEY=
# OLLAMA_MODEL=gpt-oss:120b
# OLLAMA_BASE_URL=https://ollama.com/v1

# ========== 中国火山方舟（ark- + ep- 接入点）==========
OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_API_KEY=
OPENAI_MODEL=
# ARK_API_KEY=
# ARK_ENDPOINT_ID=ep-xxxx

# ========== 本地 API 端口 ==========
PORT=8788

# ========== 专家咨询留资（默认 data/expert-consult-leads.jsonl + data/expert-consult-leads.csv，见 data/expert-consult-leads-README.txt）==========
# CONSULT_LEADS_FILE=my-leads.jsonl

# ========== 可选：生成报告调优 ==========
# LLM_MAX_RETRIES=0
# LLM_TIMEOUT_MS=120000
# COMPLETION_MAX_TOKENS=6000

# ========== Supabase（登录 + 保存申请/报告）==========
# 在 Supabase 项目 Settings → API 复制；并在 SQL Editor 执行 supabase/schema.sql
# Authentication 中启用 Email 与 Google；Site URL 设为前端地址（如 http://localhost:5173）
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ========== 邀请码解锁（可选）==========
# 需在 Supabase 执行 supabase/schema-invite-codes-v1.sql
# VITE_ENABLE_INVITE_CODES=true

# ========== Stripe 一次性解锁（服务端 + 前端同时开）==========
# 1) Stripe Dashboard → Product → 创建「一次性付款」→ 复制 Price ID（price_...）
# 2) Developers → Webhooks → 添加端点：https://你的API域名/api/stripe/webhook ，事件 checkout.session.completed
#    本地调试用：stripe listen --forward-to 127.0.0.1:8788/api/stripe/webhook（端口与下方 PORT 一致）
# 3) Supabase → Settings → API → 复制 service_role（仅后端，勿写进 VITE_*）
# 4) npm run dev 后访问 GET /api/health ，stripe.createCheckoutSession 与 stripe.webhookVerified 均应为 true
#
# VITE_ENABLE_STRIPE_CHECKOUT=true
#
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# SITE_URL=http://localhost:5173
#
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_URL=   # 可留空，服务端会回退使用 VITE_SUPABASE_URL

